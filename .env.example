# OpenRouter API key for Claude access.
# Get it from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Serper.dev API key for web search.
# Get it from: https://serper.dev
SERPER_API_KEY=your_serper_key_here

# Optional: OpenRouter model to use (defaults to anthropic/claude-sonnet-5).
# Examples: anthropic/claude-sonnet-5, anthropic/claude-sonnet-4.5, google/gemini-2.5-flash
OPENROUTER_MODEL=anthropic/claude-sonnet-5
